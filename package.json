{
  "name": "bedrock-data-generator",
  "private": true,
  "description": "Exports Minecraft Bedrock block states, collision shapes, login packets and the default skin from every Bedrock Dedicated Server build",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "postinstall": "node src/checkouts/setup.ts",
    "servers": "node --env-file-if-exists=.env src/main.ts servers",
    "blocks": "node --env-file-if-exists=.env src/main.ts blocks",
    "network": "node --env-file-if-exists=.env src/main.ts network",
    "steve": "node --env-file-if-exists=.env src/main.ts steve",
    "all": "node --env-file-if-exists=.env src/main.ts all",
    "status": "node --env-file-if-exists=.env src/main.ts status",
    "build:native": "cd native && xmake f -p windows -a x64 -m release -y -q && xmake -y -q",
    "check": "node --env-file-if-exists=.env src/main.ts check",
    "typecheck": "tsc",
    "test": "node --test \"test/**/*.test.ts\"",
    "mcdata": "node --env-file-if-exists=.env src/main.ts mcdata",
    "validate": "node --env-file-if-exists=.env src/main.ts validate"
  },
  "dependencies": {
    "bedrock-protocol": "link:./checkouts/bedrock-protocol",
    "debug": "^4.3.1",
    "json-stringify-pretty-compact": "^4.0.0",
    "jsonwebtoken": "^9.0.0",
    "jsp-raknet": "^2.1.3",
    "minecraft-bedrock-server": "1.5.2",
    "minecraft-data": "link:./checkouts/node-minecraft-data",
    "minecraft-folder-path": "^1.2.0",
    "prismarine-auth": "^3.0.0",
    "prismarine-nbt": "^2.8.0",
    "prismarine-realms": "^1.6.0",
    "protodef": "^1.19.0",
    "raknet-native": "^1.0.3",
    "uuid-1345": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "ajv": "^8.20.0",
    "typescript": "^5.9.3"
  }
}
