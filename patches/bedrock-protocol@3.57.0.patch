       client.write('resource_pack_client_response', {
         response_status: 'completed',
+      // 1.26.40+ serialises this packet as a Cereal tagged union: varint alternative
+      // index THEN the alternative's enum name. Older protocols don't declare
+      // response_name, and protodef ignores fields a schema doesn't list, so sending it
+      // unconditionally is safe.
+      response_name: 'resourcepackstackfinished',
         resourcepackids: []
       })
     })
diff --git a/src/handshake/loginVerify.js b/src/handshake/loginVerify.js
index 92984697d39d19781fb55876f2332040afa99441..a2cab6d5c68f8f7c4a0216dc6874daf078339f1e 100644
--- a/src/handshake/loginVerify.js
+++ b/src/handshake/loginVerify.js
@@ -17,7 +17,19 @@ module.exports = (client, server, options) => {
 
     const normalized = normalizeToken(token)
     const x5u = getX5U(normalized)
-    const decoded = JWT.verify(normalized, getDER(x5u), { algorithms: ['ES384', 'RS256'] })
+    // A REAL Xbox-issued MCToken is signed by Mojang's auth service and carries no `x5u` header —
+    // only the self-signed token bedrock-protocol generates for offline logins does. Without the
+    // issuer's key there is nothing to verify against, and getDER(undefined) throws
+    // ERR_INVALID_ARG_TYPE, which onLogin swallows into a bare "Server authentication error".
+    // On an offline server, decode instead of verifying (the same stance the client already takes
+    // for the server's handshake token: "No verification here, not needed").
+    let decoded
+    if (x5u) {
+      decoded = JWT.verify(normalized, getDER(x5u), { algorithms: ['ES384', 'RS256'] })
+    } else {
+      if (!options.offline) throw new Error('Login token has no x5u and cannot be verified')
+      decoded = JWT.decode(normalized)
+    }
     if (!decoded || typeof decoded !== 'object') throw new Error('Invalid login token')
 
     const payload = decoded || {}
@@ -78,7 +90,9 @@ module.exports = (client, server, options) => {
   }
 
   function verifySkin (publicKey, token) {
-    const pubKey = getDER(publicKey)
+    // The clientData JWT is self-signed by the client, so its own x5u header IS the client's public
+    // key. Fall back to it when the auth token carried none (a Mojang-issued MCToken has no `cpk`).
+    const pubKey = getDER(publicKey || getX5U(token))
     const decoded = JWT.verify(token, pubKey, { algorithms: ['ES384'] })
     return decoded
   }
