{
  "$id": "effects",
  "title": "bedrock effects.json",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "name", "displayName", "type"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "integer", "minimum": 1 },
      "name": { "type": "string", "pattern": "^[A-Z][A-Za-z]*$" },
      "displayName": { "$ref": "common#/definitions/displayName" },
      "type": { "enum": ["good", "bad"] }
    }
  }
}
