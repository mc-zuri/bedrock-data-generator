{
  "$id": "blockCollisionShapes",
  "title": "bedrock blockCollisionShapes.json",
  "type": "object",
  "required": ["blocks", "shapes"],
  "additionalProperties": false,
  "properties": {
    "blocks": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "common#/definitions/blockName" },
      "additionalProperties": {
        "oneOf": [
          { "$ref": "common#/definitions/id" },
          { "type": "array", "minItems": 1, "items": { "$ref": "common#/definitions/id" } }
        ]
      }
    },
    "shapes": {
      "type": "object",
      "required": ["0"],
      "propertyNames": { "$ref": "common#/definitions/numericKey" },
      "additionalProperties": {
        "type": "array",
        "items": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "type": "number", "minimum": -1, "maximum": 2 } }
      }
    }
  }
}
