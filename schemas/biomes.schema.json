{
  "$id": "biomes",
  "title": "bedrock biomes.json",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "name", "category", "depth", "dimension", "displayName", "color", "rainfall", "temperature"],
    "additionalProperties": false,
    "properties": {
      "id": { "$ref": "common#/definitions/id" },
      "name": { "$ref": "common#/definitions/name" },
      "category": { "enum": ["beach", "desert", "extreme_hills", "forest", "ice", "icy", "jungle", "mesa", "mountain", "mushroom", "nether", "none", "ocean", "plains", "river", "savanna", "swamp", "taiga", "the_end", "underground"] },
      "precipitation": { "enum": ["none", "rain", "snow"] },
      "has_precipitation": { "type": "boolean" },
      "depth": { "type": "number" },
      "dimension": { "enum": ["overworld", "nether", "end"] },
      "displayName": { "$ref": "common#/definitions/displayName" },
      "color": { "type": "integer", "minimum": 0, "maximum": 16777215 },
      "rainfall": { "type": "number", "minimum": 0, "maximum": 4 },
      "temperature": { "type": "number", "minimum": -1, "maximum": 4 },
      "child": { "$ref": "common#/definitions/id" },
      "parent": { "$ref": "common#/definitions/name" },
      "climates": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["temperature", "humidity", "altitude", "weirdness", "offset"],
          "additionalProperties": false,
          "properties": { "temperature": { "type": "number" }, "humidity": { "type": "number" }, "altitude": { "type": "number" }, "weirdness": { "type": "number" }, "offset": { "type": "number" } }
        }
      }
    }
  }
}
