# Copy to .env: every pnpm step reads it. Relative paths are the repo's.

# The bedrock-data checkout the files are made from
BEDROCK_DATA_DIR=../bedrock-data

# The minecraft-data checkout `pnpm generate` writes into: cloned from PrismarineJS (blobless) when missing, never
# committed to
MINECRAFT_DATA_DIR=repos/minecraft-data

# Your fork, made the checkout's `origin` (PrismarineJS: `upstream`), for pushing a pull request's branch
# MINECRAFT_DATA_FORK=https://github.com/mc-zuri/minecraft-data
