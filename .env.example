# Copy to .env to override. Relative paths are the repo's.

# <SERVERS_DIR>/<mcDataVersion>/bedrock_server.exe; point at existing servers to reuse them, e.g.
# SERVERS_DIR=D:/servers
# (a folder this repo downloaded carries .bdg-build with its exact build; a folder without one is used as-is)
SERVERS_DIR=./servers

# each build gets an IPv4 and an IPv6 port, in versions.json order
SERVER_PORT_BASE=41032

# servers run in parallel by `pnpm blocks` and `pnpm network`
JOBS=4

# where `pnpm steve` listens for the real Minecraft client
RELAY_PORT=19150
